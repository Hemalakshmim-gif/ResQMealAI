MONGODB_URI=mongodb://127.0.0.1:27017/nourivya
SOCKET_CORS_ORIGIN=http://localhost:5173
# Optional OSRM-compatible service base URL; leave blank to disable road routes and ETA.
# The configured routing service receives driver and destination coordinates.
ROUTING_API_BASE_URL=
# Optional Mapbox token enables the driving-traffic profile, traffic matrix ordering,
# and traffic-informed ETAs. Keep this server-side; do not add it to frontend env files.
MAPBOX_ACCESS_TOKEN=
DEMO_DRIVER_EMAIL=demo.driver@nourivya.test
DEMO_DRIVER_PASSWORD=replace-with-a-private-password-of-at-least-8-characters
